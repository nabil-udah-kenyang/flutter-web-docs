{
  "name": "dart-flutter-beginner-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:import-intermediate": "node tools/import-intermediate-content.mjs",
    "docs:generate": "node tools/build-vitepress-content.mjs",
    "docs:dev": "npm run docs:generate && vitepress dev site",
    "docs:build": "npm run docs:generate && vitepress build site",
    "docs:build:pages": "DOCS_BASE=/flutter-web-docs/ npm run docs:build",
    "docs:deploy": "npm run docs:build:pages",
    "docs:preview": "vitepress preview site"
  },
  "devDependencies": {
    "vitepress": "^1.6.4"
  }
}
